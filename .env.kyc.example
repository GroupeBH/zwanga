# Public mobile KYC selector: copy this setting into the existing .env/.env.local
# or the EAS environment used for the build. This example is not auto-loaded.
EXPO_PUBLIC_KYC_PROVIDER=didit
# To choose AWS instead, replace the value above with aws.
# AWS requires a native build containing ZwangaAwsLiveness and a backend with
# AWS_KYC_ENABLED=true and its IAM/storage configuration ready.
# No AWS credentials or Didit API keys belong in the mobile environment.
# EXPO_PUBLIC_AWS_KYC_ENABLED is deprecated; the explicit provider takes priority.
