{
  "name": "zwanga-app",
  "main": "expo-router/entry",
  "version": "1.0.15",
  "scripts": {
    "start": "expo start",
    "postinstall": "node ./scripts/patch-react-native-drawing-order.js && node ./scripts/patch-chottulink-ios-swift-header.js",
    "eas-build-pre-install": "node ./scripts/validate-referral-config.js && node ./scripts/validate-android-crashlytics.js",
    "check:android-crashlytics": "node ./scripts/validate-android-crashlytics.js",
    "test:android-crashlytics": "node --test ./tests/androidCrashlytics.test.js",
    "validate:referrals": "node ./scripts/validate-referral-config.js",
    "check:network": "node ./scripts/check-network-boundaries.js",
    "check:source-size": "node ./scripts/check-source-size.cjs",
    "test:referrals": "node --test ./tests/referralAttributionPolicy.test.js",
    "test:performance": "node --test ./tests/performancePolicy.test.js",
    "test:trip-request": "node --test ./tests/tripRequestForm.test.js ./tests/tripRequestEditPricing.test.js ./tests/tripRequestExpiration.test.js ./tests/passengerSeats.test.js",
    "test:profile": "node --test ./tests/profileModules.test.js",
