    "test:search": "node --test ./tests/searchScreen.test.js ./tests/compactSearchCards.test.js",
    "test:trip-cards": "node --test ./tests/tripListCards.test.js ./tests/personalListCards.test.js ./tests/manageTripSummary.test.js ./tests/compactCardsLifecycle.test.js",
