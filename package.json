    "test:ride-recovery": "node --test ./tests/rideRecovery.test.js ./tests/rideRecoveryUI.test.js",
    "test:location-picker": "node --test ./tests/locationPicker.test.js",
    "test:form-layout": "node --test ./tests/formSafeArea.test.js",
    "test:notifications": "node --test ./tests/notificationNavigation.test.js ./tests/assignedTripNavigation.test.js",
    "test:interruption": "node --test ./tests/interruptionChoice.test.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "version": "eas version"
  },
