# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
# Keep machine-specific native caches out of the EAS archive. These rules
# intentionally live at the ROOT: older EAS CLI versions on Windows can miss
# nested .gitignore rules when the copy filter receives backslash paths.
/android/**/build/
/android/**/.gradle/
/android/**/.kotlin/
/android/**/.cxx/
/android/**/.idea/
/android/local.properties
/android/**/*.iml
/android/**/*.hprof
/android/**/*.jsbundle
/ios/**/build/
/ios/**/DerivedData/
/ios/Pods/
/ios/**/xcuserdata/
/ios/**/*.xcuserstate
/ios/**/*.xccheckout
/ios/**/*.moved-aside
/ios/**/*.hmap
/ios/**/*.ipa
/ios/**/*.jsbundle
/ios/.xcode.env.local
/ios/**/*.pbxuser
!/ios/**/default.pbxuser
/ios/**/*.mode1v3
!/ios/**/default.mode1v3
/ios/**/*.mode2v3
!/ios/**/default.mode2v3
/ios/**/*.perspectivev3
!/ios/**/default.perspectivev3
# Do NOT ignore /android, /ios, shared workspaces, Gradle wrapper, native KYC
# sources, Podfile.lock, Swift package resolution or notification resources.
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
env.local
.env.local
.env.production.local
.env.development.local
.env.test.local

# typescript
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.log
*.tmp

